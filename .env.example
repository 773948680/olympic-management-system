# Copier ce fichier en .env puis ajuster les valeurs si necessaire.
# docker compose lit automatiquement le fichier .env place a la racine du projet.

MYSQL_ROOT_PASSWORD=root_dev_password
MYSQL_DATABASE=olympic_management
MYSQL_USER=olympic_app
MYSQL_PASSWORD=olympic_app_password

# Utilises par le backend Spring Boot (backend/src/main/resources/application.yml).
# Doivent correspondre a MYSQL_USER / MYSQL_PASSWORD ci-dessus.
DB_USERNAME=olympic_app
DB_PASSWORD=olympic_app_password
